# Copy this file to .env and fill in your staging account.
LOGIN_EMAIL="you@revolab.ai"
LOGIN_PASSWORD="your-password"
# Optional: only if you must pick an organization after sign-in
LOGIN_ORGANIZATION=""
# Optional: name shown in the sidebar after login
LOGIN_DISPLAY_NAME=""

# Dedicated account for the change-password test (AT-LOGIN-004). Never use the LOGIN_* account for it.
# CHANGE_PWD_PASSWORD must be the account's ORIGINAL password; the test changes it and always restores it.
CHANGE_PWD_EMAIL="change-pwd-account@revolab.ai"
CHANGE_PWD_PASSWORD="original-password"
# Optional: organization to pick after sign-in (defaults to test-data/login/change-password.json)
CHANGE_PWD_ORGANIZATION=""
